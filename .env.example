# Copy to .env and fill in. .env is gitignored.
#
# Only the model-backed agents need this. Discovery and harvesting are plain
# HTTP against public ATS endpoints, so a real job search works without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional: retier the models. Agents declare a tier, never a model id.
# JOBSEARCH_MODEL_STRONG=claude-opus-5
# JOBSEARCH_MODEL_MID=claude-sonnet-5
# JOBSEARCH_MODEL_FAST=claude-haiku-4-5

# Optional
# JOBSEARCH_DB=./job-search-aiagent.sqlite
# JOBSEARCH_TEMPLATE=modern
